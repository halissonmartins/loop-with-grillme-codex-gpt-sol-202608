{
  "name": "relatorios-agendados",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "frontend"
  ],
  "overrides": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "npm run build --workspace @relatorios/frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace @relatorios/frontend && npm run format:check",
    "start": "npm run start --workspace @relatorios/frontend",
    "test": "npm run test --workspace @relatorios/frontend",
    "typecheck": "npm run typecheck --workspace @relatorios/frontend"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
